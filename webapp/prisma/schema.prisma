// ============================================================================
// ZERO-BASED FINANCIAL TRACKER — PRISMA SCHEMA
// ============================================================================
// Architecture notes (read before extending this file):
//
// MONEY: every monetary value is a signed Int representing total cents.
//   Never store money as Float/Decimal. Convert to display strings only in
//   the UI layer via /lib/utils/currency.ts.
//
// ENVELOPE ENGINE: "Ready to Assign" is NOT a stored balance. It is computed
//   in the service layer as:
//     RTA = SUM(inflow to on-budget accounts, categorized as INCOME)
//         − SUM(all BudgetAssignment.amountCents across all categories/months)
//   A category's rolling "available" balance is likewise computed
//   (cumulative assignments − cumulative activity, rolled forward month over
//   month) rather than cached here, to avoid drift between a stored number
//   and the ledger that produced it. If query performance later demands a
//   cache, add it behind a service function with an explicit reconciliation
//   job — don't just bolt a balance column onto Category.
//
// AUDIT TRAIL: money entering/leaving an envelope's assigned pool is always
//   a new BudgetAssignment row, tagged with a `source` — including the
//   automatic 30% tax holdback (AUTO_TAX_RESERVE) and the tax-savings
//   rebalance release (REBALANCE_TAX_RELEASE) triggered by logging a
//   deductible expense. Never mutate an "assigned" number in place; append,
//   so the full history of who/what moved money is reconstructable.
//
// SOFT DELETE: Account, Payee, Category, and CategoryGroup are archived
//   (`isArchived`), never hard-deleted — Transaction rows reference them
//   permanently for financial and tax history. FK `onDelete` behavior below
//   is a safety net for the rare hard-delete attempt, not the primary
//   deletion path the app should expose in the UI.
//
// AUTH: `User` is intentionally minimal (email + password hash). If/when
//   NextAuth is wired in, its OAuth model is also literally called "Account"
//   — that collides with our financial Account model below. Introduce
//   NextAuth's models at that point as `AuthAccount`, `AuthSession`, and
//   `VerificationToken`; do not rename our financial Account model to make
//   room for it.
//
// TRANSFERS: modeled as two linked Transaction rows (one per account),
//   joined by a shared `transferGroupId`. Transfers between two on-budget
//   accounts leave `categoryId` null (moving money between your own accounts
//   isn't spending). A transfer touching an off-budget account (e.g. paying
//   a credit card from checking, or moving money to an investment account)
//   DOES need a category on the off-budget leg — that's a service-layer rule
//   to enforce when the transfer feature is built, not a schema constraint.
//
// SPLIT TRANSACTIONS: Transaction.categoryId stays the fast path for the
//   common single-category case. TransactionSplit rows are the source of
//   truth once a transaction is split across categories (e.g. one Target run
//   covering groceries + household). When split rows exist, the service
//   layer must treat them as authoritative for category activity/reporting
//   and ignore Transaction.categoryId. SUM(TransactionSplit.amountCents) for
//   a transaction must equal that Transaction's amountCents — Postgres can't
//   express that as a declarative constraint across child rows without a
//   trigger, so this is an app-layer invariant to enforce on every write.
//
// RECEIPTS: scanning/OCR is an external capability (Claude API vision, or a
//   dedicated receipt API like Veryfi/Mindee/Textract) — the schema is
//   provider-agnostic and just stores the extracted result. A Receipt can
//   exist standalone (not yet matched to a Transaction) or be linked 1:1 to
//   one. Line items carry an AI-suggested category; approving a processed
//   receipt is what actually commits TransactionSplit rows, mirroring the
//   CSV import "review before commit" pattern already used elsewhere here.
//
// SAVINGS / CASHFLOW INSIGHTS: SavingsOpportunity ("we found this cheaper
//   elsewhere") and BudgetRecommendation ("cut/add/reallocate") are both
//   *results* of an external analysis step (a web-search-capable agent or a
//   shopping-price API), not something Postgres computes. They're modeled as
//   typed, auditable, dismissible records so the app has a persistent inbox
//   of advice instead of regenerating the same suggestion every session.
//
// PRIORITY WATERFALL: Category.priorityRank + funding-target fields drive an
//   auto-assign algorithm (service layer, see below) that fills envelopes in
//   priority order — each bucket funded to its target before the next one
//   gets anything. WaterfallRun groups the BudgetAssignment rows one
//   auto-assign pass produced, so "what did auto-assign just do, and where
//   did it run out" is fully reconstructable and visualizable.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

// As of Prisma 7, connection URLs no longer live in the schema file.
// - CLI operations (generate, migrate) get their connection from
//   prisma.config.ts, at the project root — using DIRECT_URL (unpooled),
//   since migrations need a direct connection.
// - The runtime PrismaClient gets its connection from a driver adapter
//   passed to its constructor in lib/prisma.ts — using DATABASE_URL
//   (pooled), since serverless functions open many short-lived
//   connections and need Supabase's pooler.
// See .env.example for both values.
datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum WorkspaceType {
  PERSONAL
  BUSINESS
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  LOAN
  PROPERTY
  OTHER_ASSET
  OTHER_LIABILITY
}

/// How an Account's current balance is derived.
enum BalanceMode {
  /// Balance = running sum of Transaction.amountCents for this account
  /// (checking, savings, credit cards, cash).
  TRANSACTION_DERIVED
  /// Balance = latest ManualBalanceEntry (illiquid net-worth assets you
  /// periodically re-value rather than transact against: real estate,
  /// vehicles, etc.).
  MANUAL
}

enum CategoryType {
  /// Feeds "Ready to Assign" when money hits this category; itself never
  /// receives a budget assignment.
  INCOME
  /// A normal spending envelope.
  EXPENSE
  /// App-managed envelope the system creates and maintains automatically
  /// (e.g. "Estimated Tax Reserve").
  SYSTEM
}

enum ScheduleCLineItem {
  ADVERTISING
  CAR_AND_TRUCK
  COMMISSIONS_AND_FEES
  CONTRACT_LABOR
  INSURANCE
  INTEREST
  LEGAL_AND_PROFESSIONAL
  OFFICE_EXPENSE
  RENT_OR_LEASE
  REPAIRS_AND_MAINTENANCE
  SUPPLIES
  TAXES_AND_LICENSES
  TRAVEL
  MEALS
  UTILITIES
  WAGES
  SOFTWARE_AND_SUBSCRIPTIONS
  OTHER
}

enum ClearedStatus {
  UNCLEARED
  CLEARED
  RECONCILED
}

/// Why money moved into/out of a category's assigned pool.
enum AssignmentSource {
  MANUAL
  AUTO_TAX_RESERVE
  REBALANCE_TAX_RELEASE
  ROLLOVER
  CORRECTION
  /// Produced by a priority-waterfall auto-assign run. See WaterfallRun.
  AUTO_WATERFALL
  /// Produced by "Assign by percentages" (category/pocket allocation split).
  AUTO_PERCENT
  /// Produced by the cashflow waterfall "Assign" button (taxes / OPEX / reservoirs / cash).
  WATERFALL
  /// Money pulled from the reserves to cover a shortfall (negative rows on the
  /// reserve, positive row on the covered pocket).
  WATERFALL_COVER
}

/// Spending lens for an expense. An expense can carry several.
enum ExpenseTag {
  CULTIVATE
  PRESERVE
  SUPPORT
  REGENERATE
  LEAKAGE
}

/// Answer to a yes/no question in the monthly expense review.
enum ReviewAnswer {
  YES
  NO
  UNSURE
}

/// What an expense does for the business (monthly expense review, question 2).
enum StrategicValue {
  CAPACITY
  RISK
  STRENGTH
}

/// Finer classification of an asset or liability for the cash flow statement.
/// Null on an Account = derive from AccountType.
enum HoldingClass {
  CASH_SAVINGS
  STOCKS_FUNDS
  REAL_ESTATE
  BUSINESS
  VEHICLE
  OTHER_ASSET
  CRYPTO
  COLLECTIBLES
  MORTGAGE
  STUDENT_LOAN
  CAR_LOAN
  CREDIT_CARD
  BANK_LOAN
  OTHER_LIABILITY
}

/// Where an income pocket sits on the cash flow statement. Null = EARNED.
enum IncomeKind {
  EARNED
  PORTFOLIO
  PASSIVE
}

/// The reserves money can be pulled from to cover a shortfall.
enum ReserveBucket {
  TAXES
  RESERVOIR_1
  RESERVOIR_2
}

enum TaxQuarter {
  Q1
  Q2
  Q3
  Q4
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// How a priority-bucket Category's funding target is defined.
enum FundingTargetType {
  /// Needs this amount assigned fresh every month (Rent, Groceries).
  MONTHLY_FUNDING
  /// Needs to reach and then hold this balance (emergency fund, insurance
  /// reserve) — once funded, the waterfall skips it until it drops below target.
  TARGET_BALANCE
  /// Needs to reach the balance by a specific date (save $1,200 by December).
  TARGET_BALANCE_BY_DATE
}

enum ReceiptStatus {
  PENDING_UPLOAD
  PROCESSING
  PROCESSED
  NEEDS_REVIEW
  FAILED
}

enum SavingsOpportunityStatus {
  NEW
  DISMISSED
  ACTED_ON
  EXPIRED
}

enum RecommendationType {
  CUT_SPENDING
  INCREASE_ALLOCATION
  /// "Add this to the budget" — e.g. suggest a new category/habit that
  /// could capture or protect revenue.
  NEW_CATEGORY_SUGGESTION
  REVENUE_OPPORTUNITY
  REALLOCATE_PRIORITY
  CASH_FLOW_WARNING
}

enum RecommendationStatus {
  NEW
  ACCEPTED
  DISMISSED
  EXPIRED
}

// ----------------------------------------------------------------------------
// USER
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  /// Profile picture (square JPEG, resized in the browser).
  avatarData   Bytes?
  avatarMime   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaces   Workspace[]
  transactions Transaction[] @relation("TransactionPerson")
  expenseReviews ExpenseReview[]
  stewardedAccounts Account[] @relation("AccountSteward")
  pushSubscriptions PushSubscription[]
  pushSent          PushSent[]
  pushPref          PushPref?
  homeLayout        HomeLayout?

  @@map("users")
}

// ----------------------------------------------------------------------------
// WORKSPACE — the Personal / Business isolation boundary
// ----------------------------------------------------------------------------

model Workspace {
  recurringItems RecurringItem[]
  id         String        @id @default(cuid())
  ownerId    String
  owner      User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  type       WorkspaceType
  isArchived Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  taxProfile     TaxProfile?
  accounts       Account[]
  payees         Payee[]
  categoryGroups CategoryGroup[]
  categories     Category[]
  transactions   Transaction[]
  importBatches  ImportBatch[]
  taxPayments    TaxPayment[]
  receipts              Receipt[]
  products              Product[]
  savingsOpportunities  SavingsOpportunity[]
  budgetRecommendations BudgetRecommendation[]
  cashflowForecasts     CashflowForecast[]
  waterfallRuns         WaterfallRun[]
  waterfallConfig       WaterfallConfig?
  personalFlowConfig    PersonalFlowConfig?
  reserveDraws          ReserveDraw[]
  expenseReviews        ExpenseReview[]
  historySettings       HistorySettings?
  historyReviews        HistoryReview[]
  pocketTags            PocketTag[]
  historyTotals         HistoryTotal[]
  balanceCheckpoints    BalanceCheckpoint[]
  historyAccounts       HistoryAccount[]
  historicalTransactions HistoricalTransaction[]

  @@index([ownerId])
  @@map("workspaces")
}

/// 1:1 with a BUSINESS workspace. Unused/ignored for PERSONAL workspaces.
model TaxProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Default 30.00%. Decimal here is fine — this is a rate/multiplier, not a
  /// currency amount, so it's exempt from the integer-cents rule.
  reserveRatePercent Decimal @default(30.00) @db.Decimal(5, 2)

  /// The SYSTEM category that automatically receives the tax holdback.
  reserveCategoryId String?   @unique
  reserveCategory   Category? @relation("TaxReserveCategory", fields: [reserveCategoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tax_profiles")
}

// ----------------------------------------------------------------------------
// ACCOUNTS — physical/real-world locations of money, separate from envelopes
// ----------------------------------------------------------------------------

model Account {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  type        AccountType
  balanceMode BalanceMode @default(TRANSACTION_DERIVED)

  /// On-budget accounts participate in the envelope engine: their inflows
  /// can be assigned to categories, their outflows count as category
  /// activity. Off-budget/tracking accounts (INVESTMENT, LOAN, PROPERTY,
  /// typically) still count toward Net Worth but never touch "Ready to
  /// Assign".
  onBudget Boolean @default(true)

  /// Seed balance the running transaction ledger starts counting from.
  /// Only meaningful when balanceMode = TRANSACTION_DERIVED.
  openingBalanceCents Int       @default(0)
  openingBalanceDate  DateTime? @db.Date

  /// Asset/liability classification for the cash flow statement (null = derive from type).
  holdingClass HoldingClass?
  /// Assets: monthly income this asset produces. Liabilities: the monthly payment. Always positive.
  monthlyCashflowCents Int?

  /// The household member who looks after this account; money assigned from it is attributed to them.
  stewardId String?
  steward   User?   @relation("AccountSteward", fields: [stewardId], references: [id], onDelete: SetNull)

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions          Transaction[]        @relation("AccountTransactions")
  transferTransactions  Transaction[]        @relation("TransferAccountTransactions")
  manualBalanceEntries  ManualBalanceEntry[]
  holdingDetail         HoldingDetail?       @relation("HoldingDetailOwner")
  creditLimit           CreditLimit?
  recurringItems        RecurringItem[]
  holdingPositions      HoldingPosition[]
  balanceCheckpoints    BalanceCheckpoint[]
  securedByThis         HoldingDetail[]      @relation("HoldingDetailLoan")
  fundedAssignments     BudgetAssignment[]   @relation("AssignmentFunding")
  pocketsPaidFrom       Category[]           @relation("PocketPaidFrom")
  loanPocket            Category?            @relation("PocketLoan")
  /// The budget pocket that feeds this asset (a savings goal for it): money is set aside in the pocket, then put into the asset.
  assetPocket           Category?            @relation("PocketAsset")
  importBatches         ImportBatch[]
  taxPaymentsSourced     TaxPayment[]
  historyAccount         HistoryAccount?
  historicalTransactions HistoricalTransaction[]

  @@index([workspaceId])
  @@index([stewardId])
  @@map("accounts")
}

/// Point-in-time valuations for MANUAL-balance-mode accounts — illiquid
/// net-worth assets that aren't transaction-driven (real estate, vehicles).
model ManualBalanceEntry {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asOfDate     DateTime @db.Date
  balanceCents Int
  note         String?
  createdAt    DateTime @default(now())

  @@index([accountId, asOfDate])
  @@map("manual_balance_entries")
}

/// What a holding is made of, priced from live markets.
enum PositionKind {
  CRYPTO
  STOCK
}

/// Extra facts about an asset or liability: cost basis, loan terms, vehicle info, notes.
model HoldingDetail {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation("HoldingDetailOwner", fields: [accountId], references: [id], onDelete: Cascade)

  /// Assets: what was paid in total (for gain/loss). Optional.
  costBasisCents Int?
  purchaseDate   DateTime? @db.Date
  notes          String?
  /// Uninvested cash sitting in a brokerage/crypto account (added to the priced positions).
  cashCents      Int       @default(0)
  /// The loan that is secured by this asset (home, car) — equity = value - what is owed.
  linkedLoanId   String?
  linkedLoan     Account?  @relation("HoldingDetailLoan", fields: [linkedLoanId], references: [id], onDelete: SetNull)

  /// Loans: yearly interest rate in hundredths of a percent (6.25% = 625).
  interestRateBps     Int?
  termMonths          Int?
  originalAmountCents Int?
  loanStartDate       DateTime? @db.Date
  /// Loans: due date of the first payment; later payments fall on the same day each month.
  firstPaymentDate    DateTime? @db.Date

  /// Credit cards: day of the month the statement closes / the payment is due.
  statementDay Int?
  dueDay       Int?

  /// Vehicles.
  vin          String?
  vehicleYear  Int?
  vehicleMake  String?
  vehicleModel String?
  vehicleTrim  String?
  mileage      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("holding_details")
}

/// A number of coins or shares of one symbol, valued at the latest market price.
model HoldingPosition {
  id         String       @id @default(cuid())
  accountId  String
  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind       PositionKind
  /// Ticker (AAPL, VTI) or coin symbol (BTC, ETH), upper-case.
  symbol     String
  name       String?
  /// Units held. Decimal because coins are fractional; value is rounded to cents only at the end.
  quantity   Decimal      @db.Decimal(30, 12)
  /// Total paid for this position (optional, for gain/loss).
  costBasisCents Int?
  /// Latest USD price per unit and when/where it came from.
  lastPrice    Decimal?  @db.Decimal(30, 12)
  priceAt      DateTime?
  priceSource  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activity     PositionActivity[]

  @@unique([accountId, kind, symbol])
  @@index([accountId])
  @@map("holding_positions")
}

enum PositionActivityKind {
  BOUGHT
  REINVESTED
}

/// Shares/coins added to a position: bought more, or a reinvested dividend. Adds to quantity and cost basis.
model PositionActivity {
  id           String                   @id @default(cuid())
  positionId   String
  position     HoldingPosition          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  kind         PositionActivityKind
  date         DateTime                 @db.Date
  shares       Decimal                  @db.Decimal(30, 12)
  /// Dollars paid / reinvested (added to cost basis when the position has one).
  amountCents  Int
  note         String?
  createdAt    DateTime                 @default(now())

  @@index([positionId, date])
  @@map("position_activity")
}

// ----------------------------------------------------------------------------
// PAYEES
// ----------------------------------------------------------------------------

model Payee {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  /// Autofill convenience — last/preferred category for this payee.
  defaultCategoryId String?
  defaultCategory   Category? @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  isArchived        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  transactions Transaction[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("payees")
}

// ----------------------------------------------------------------------------
// ENVELOPE CATEGORIES
// ----------------------------------------------------------------------------

model CategoryGroup {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int       @default(0)
  /// Share of income this category receives when assigning by percentages,
  /// in basis points (2500 = 25.00%). Null = not part of the split.
  allocationBps Int?
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categories Category[]

  @@index([workspaceId])
  @@map("category_groups")
}

model Category {
  id              String         @id @default(cuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryGroupId String?
  categoryGroup   CategoryGroup? @relation(fields: [categoryGroupId], references: [id], onDelete: SetNull)
  name            String
  type            CategoryType   @default(EXPENSE)

  /// Business tax engine fields — only meaningful when workspace.type =
  /// BUSINESS and type = EXPENSE.
  isTaxDeductible   Boolean            @default(false)
  scheduleCLineItem ScheduleCLineItem?
  /// WaiWai classification key (lib/budget/expense-types.ts), e.g. ADVERTISING.
  expenseType       String?
  /// Income pockets only: earned / portfolio / passive. Null = earned.
  incomeKind        IncomeKind?
  /// Pockets in the waterfall's Cash category: this pocket's share of the cash, in basis points.
  cashShareBps      Int?
  /// Personal Give/Save/Live flow: this pocket's share of what is left in its bucket after targets are met (basis points).
  flowShareBps      Int?

  /// True for app-managed envelopes (e.g. "Estimated Tax Reserve") the UI
  /// should prevent users from freely renaming, deleting, or repurposing.
  isSystemManaged Boolean  @default(false)
  sortOrder       Int      @default(0)

  /// --- Priority waterfall ---
  /// Lower = funded first when an auto-assign pass runs. Null = this
  /// category sits outside the waterfall (manual assignment only). Ties are
  /// allowed — the service layer decides how same-rank categories share a
  /// pass (e.g. funded in parallel).
  /// Share of its category's allocation (basis points, 5000 = 50.00%).
  allocationBps       Int?
  /// Day of the month this bill/expense is due (1-31; short months use their last day). Null = no due date.
  dueDay              Int?
  priorityRank        Int?
  fundingTargetType   FundingTargetType?
  fundingTargetCents  Int?
  fundingTargetByDate DateTime?           @db.Date
  /// The bank account this pocket is usually paid from (null = any). Funding draws from it first.
  /// Monthly-cost pockets: extra months of the cost to keep on hand beyond the current month (0 = this month only).
  monthsAhead Int @default(0)
  /// Set on the budget pocket that pays a loan (a LOAN account); the pocket follows that loan's schedule.
  loanAccountId String? @unique
  loanAccount   Account? @relation("PocketLoan", fields: [loanAccountId], references: [id], onDelete: SetNull)
  /// Set on a pocket that feeds an asset (gold, a rental, a brokerage...). The pocket still holds the money set aside;
  /// the asset's own current value is what its progress bar shows, measured against assetGoalCents.
  assetAccountId String? @unique
  assetAccount   Account? @relation("PocketAsset", fields: [assetAccountId], references: [id], onDelete: SetNull)
  /// What you want the linked asset to be worth (null = no goal set yet).
  assetGoalCents Int?
  paidFromAccountId String?
  paidFromAccount   Account?              @relation("PocketPaidFrom", fields: [paidFromAccountId], references: [id], onDelete: SetNull)

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  budgetAssignments BudgetAssignment[]
  transactions      Transaction[]
  transactionSplits TransactionSplit[]
  payeeDefaults     Payee[]
  taxProfileFor     TaxProfile?        @relation("TaxReserveCategory")
  receiptLineItems      ReceiptLineItem[]
  defaultForProducts    Product[]
  budgetRecommendations BudgetRecommendation[]
  billPayments          BillPayment[]
  tagLinks              PocketTagLink[]

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([workspaceId, priorityRank])
  @@map("categories")
}

/// Ledger of every dollar moved into/out of a category's assigned pool.
/// "Assigned this month" = SUM(amountCents) grouped by category + month.
/// Rolling "available" balance = cumulative(assignments) −
/// cumulative(transaction activity) through that month — computed in the
/// service layer, not stored here (see header note).
/// "I paid this bill" marker for one pocket in one month. Payments recorded as
/// transactions also count as paid automatically; this covers bills paid
/// outside the app or a month-by-month manual tick.
model BillPayment {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// First of the month the payment covers, e.g. 2026-10-01.
  month      DateTime @db.Date
  paidAt     DateTime @default(now())

  @@unique([categoryId, month])
  @@map("bill_payments")
}

model BudgetAssignment {
  id     String           @id @default(cuid())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Normalized to the first of the month, e.g. 2026-09-01.
  month       DateTime         @db.Date
  amountCents Int
  source      AssignmentSource @default(MANUAL)

  /// Set when source = AUTO_TAX_RESERVE or REBALANCE_TAX_RELEASE, linking
  /// back to the income/expense Transaction that triggered this movement.
  relatedTransactionId String?
  relatedTransaction   Transaction? @relation(fields: [relatedTransactionId], references: [id], onDelete: SetNull)

  /// Set when source = AUTO_WATERFALL, grouping every row one auto-assign
  /// pass produced so it can be shown/reported as a single event.
  waterfallRunId String?
  waterfallRun   WaterfallRun? @relation(fields: [waterfallRunId], references: [id], onDelete: SetNull)

  /// The bank account this money was tagged to when it arrived as income. The tag rides along
  /// when money is assigned, moved between pockets or released back to Ready to assign.
  /// Null = money assigned before accounts were tracked (shown as "not tagged yet").
  fundingAccountId String?
  fundingAccount   Account? @relation("AssignmentFunding", fields: [fundingAccountId], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now())

  @@index([categoryId, month])
  @@index([waterfallRunId])
  @@index([fundingAccountId])
  @@map("budget_assignments")
}

// ----------------------------------------------------------------------------
// TRANSACTIONS
// ----------------------------------------------------------------------------

model Transaction {
  id String @id @default(cuid())

  /// Denormalized from account.workspaceId — deliberate. Enforces/queries
  /// workspace isolation directly without a join on every read, and lets
  /// the service layer cheaply validate "this account belongs to this
  /// workspace" before writing.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Restrict)

  /// Null for: uncategorized transactions awaiting review, and the "other
  /// leg" of a transfer between two on-budget accounts (see header note on
  /// transfers).
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  payeeId String?
  payee   Payee? @relation(fields: [payeeId], references: [id], onDelete: Restrict)

  /// Signed cents on THIS account's ledger: positive = inflow, negative =
  /// outflow.
  amountCents   Int
  date          DateTime      @db.Date
  memo          String?
  clearedStatus ClearedStatus @default(UNCLEARED)
  flagColor     String?

  /// Snapshot of deductibility at the time of entry, independent of the
  /// category's current default — keeps historical tax reporting accurate
  /// even if the category's isTaxDeductible flag changes later. Tax savings
  /// = amountCents × TaxProfile.reserveRatePercent, computed on read.
  isTaxDeductible Boolean @default(false)

  /// Groups the two rows of an inter-account transfer together.
  transferGroupId   String?
  transferAccountId String?
  transferAccount   Account? @relation("TransferAccountTransactions", fields: [transferAccountId], references: [id], onDelete: SetNull)

  /// CSV import bookkeeping.
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  /// Hash of (accountId + date + amountCents + raw payee/memo) — prevents
  /// re-importing the same bank-statement row twice. Nullable; Postgres
  /// allows multiple NULLs under a unique constraint, so manually entered
  /// transactions (no hash) are unaffected.
  importHash    String?
  needsReview   Boolean @default(false)

  /// Spending lenses (Cultivate / Preserve / Support / Regenerate / Leakage). Several allowed.
  tags ExpenseTag[] @default([])

  /// Which household member made this purchase / received this money.
  personId String?
  person   User?   @relation("TransactionPerson", fields: [personId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgetAssignmentsTriggered BudgetAssignment[]
  taxPayment                 TaxPayment?
  splits  TransactionSplit[]
  receipt Receipt?
  expenseReview ExpenseReview?

  @@unique([accountId, importHash])
  @@index([workspaceId, date])
  @@index([personId])
  @@index([accountId, date])
  @@index([categoryId])
  @@index([transferGroupId])
  @@map("transactions")
}

// ----------------------------------------------------------------------------
// CSV IMPORT
// ----------------------------------------------------------------------------

model ImportBatch {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  fileName    String
  status      ImportStatus @default(PROCESSING)

  rowCount          Int @default(0)
  importedRowCount  Int @default(0)
  duplicateRowCount Int @default(0)

  createdAt DateTime @default(now())

  transactions Transaction[]

  @@index([workspaceId])
  @@map("import_batches")
}

// ----------------------------------------------------------------------------
// QUARTERLY ESTIMATED TAX PAYMENTS
// ----------------------------------------------------------------------------

model TaxPayment {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taxYear     Int
  quarter     TaxQuarter
  amountCents Int
  paidDate    DateTime   @db.Date

  sourceAccountId String
  sourceAccount   Account @relation(fields: [sourceAccountId], references: [id], onDelete: Restrict)

  /// The outflow Transaction this payment created, drawing down the
  /// Estimated Tax Reserve envelope.
  relatedTransactionId String?      @unique
  relatedTransaction   Transaction? @relation(fields: [relatedTransactionId], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now())

  @@unique([workspaceId, taxYear, quarter])
  @@index([workspaceId])
  @@map("tax_payments")
}

// ----------------------------------------------------------------------------
// SPLIT TRANSACTIONS
// ----------------------------------------------------------------------------

/// One category's share of a transaction whose spend crosses multiple
/// envelopes (e.g. a single Target receipt covering groceries + household).
/// See header note on SPLIT TRANSACTIONS for the authoritative-source rule.
model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Signed cents, same convention as Transaction.amountCents.
  amountCents     Int
  memo            String?
  isTaxDeductible Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([categoryId])
  @@map("transaction_splits")
}

// ----------------------------------------------------------------------------
// RECEIPTS
// ----------------------------------------------------------------------------

model Receipt {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Usually 1:1 with the Transaction it documents. Nullable — a receipt can
  /// be uploaded before it's matched (or before a Transaction even exists,
  /// e.g. a cash purchase that the receipt itself will generate).
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  /// The raw image/PDF lives in object storage (S3/R2/Supabase Storage), not
  /// in Postgres — this is the storage key, not the bytes.
  fileStorageKey String
  fileUrl        String?
  mimeType       String
  fileSizeBytes  Int?
  /// Receipt bytes (images are downscaled in the browser first).
  fileData       Bytes?
  fileName       String?

  status       ReceiptStatus @default(PENDING_UPLOAD)
  merchantName String?
  /// Raw OCR merchant text before normalization/matching to a known Payee.
  merchantRaw   String?
  purchaseDate  DateTime? @db.Date
  subtotalCents Int?
  taxCents      Int?
  tipCents      Int?
  totalCents    Int?

  /// Full raw OCR/vision-model response — kept so a receipt can be
  /// reprocessed (e.g. after improving extraction logic) without re-scanning.
  ocrRawResponse Json?
  /// 0.000–1.000
  ocrConfidence  Decimal? @db.Decimal(4, 3)
  /// e.g. "claude-vision", "textract", "veryfi" — whichever provider you pick.
  ocrProvider    String?

  uploadedAt  DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lineItems ReceiptLineItem[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("receipts")
}

model ReceiptLineItem {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  /// As printed on the receipt.
  rawDescription String
  /// Cleaned/normalized product name for matching across receipts.
  normalizedName String?
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  quantity       Decimal @default(1) @db.Decimal(10, 3)
  unitPriceCents Int?
  totalCents     Int

  /// AI-suggested category for this line item. This is a suggestion, not a
  /// committed accounting record — approving the receipt is what turns it
  /// into a real TransactionSplit row (see header note on RECEIPTS).
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isTaxDeductible Boolean   @default(false)

  createdAt DateTime @default(now())

  savingsOpportunities SavingsOpportunity[]

  @@index([receiptId])
  @@index([productId])
  @@map("receipt_line_items")
}

/// Canonical product identity, built up from receipt line items over time,
/// so price history and "have we bought this before" analysis has something
/// stable to key off instead of re-parsing raw receipt text every time.
model Product {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Normalized/canonical name, e.g. "Tide Pods 42ct".
  name       String
  brand      String?
  /// Barcode/UPC if ever captured — enables exact-match price lookups.
  upc        String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Flipped true once purchased 2+ times — signals this is worth including
  /// in recurring-purchase savings analysis rather than a one-off buy.
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems            ReceiptLineItem[]
  savingsOpportunities SavingsOpportunity[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("products")
}

// ----------------------------------------------------------------------------
// SAVINGS & CASHFLOW INSIGHTS
// ----------------------------------------------------------------------------

/// A "we found this cheaper elsewhere" result. Populated by an external
/// analysis step (web-search agent or shopping-price API) — see header note.
model SavingsOpportunity {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  productId  String?
  product    Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  lineItemId String?
  lineItem   ReceiptLineItem? @relation(fields: [lineItemId], references: [id], onDelete: SetNull)

  /// Denormalized snapshot so the insight still reads sensibly even if the
  /// source product/line item is later archived or deleted.
  itemDescription String
  paidPriceCents  Int
  paidAtMerchant  String?
  paidAtDate      DateTime @db.Date

  suggestedSource       String
  suggestedPriceCents   Int
  suggestedUrl          String?
  /// paidPriceCents − suggestedPriceCents, same unit basis.
  estimatedSavingsCents Int

  /// e.g. "web_search_agent_v1" — how this suggestion was produced, for
  /// trust/debugging when providers or prompts change over time.
  analysisMethod String
  confidence     Decimal? @db.Decimal(4, 3)
  evidenceNote   String?

  status      SavingsOpportunityStatus @default(NEW)
  generatedAt DateTime                 @default(now())
  reviewedAt  DateTime?

  @@index([workspaceId, status])
  @@map("savings_opportunities")
}

/// A cashflow/budget-allocation suggestion — cut this, add that, reallocate
/// priority here. Also a result of an external analysis step, stored as a
/// persistent, dismissible/acceptable inbox item rather than regenerated
/// fresh every time the app is opened.
model BudgetRecommendation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  type       RecommendationType
  categoryId String?
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title     String
  /// The "why" — the analysis narrative shown to the user.
  rationale String

  /// The historical window this recommendation was generated from.
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  /// e.g. -5000 (cut $50/mo) or +20000 (allocate $200/mo more).
  suggestedChangeCents Int?
  projectedImpactCents Int?

  analysisMethod String
  confidence     Decimal? @db.Decimal(4, 3)

  status      RecommendationStatus @default(NEW)
  generatedAt DateTime             @default(now())
  reviewedAt  DateTime?

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@map("budget_recommendations")
}

/// Cached forward-looking cashflow projection, so the reporting UI has
/// something to chart without recomputing live on every page load.
model CashflowForecast {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  asOfDate    DateTime @db.Date
  horizonDays Int

  projectedIncomeCents         Int
  projectedExpenseCents        Int
  projectedEndingBalanceCents  Int
  lowestProjectedBalanceCents  Int
  lowestBalanceDate            DateTime? @db.Date

  generatedAt DateTime @default(now())

  @@unique([workspaceId, asOfDate, horizonDays])
  @@map("cashflow_forecasts")
}

// ----------------------------------------------------------------------------
// PRIORITY WATERFALL
// ----------------------------------------------------------------------------

/// One "run new money through the priority buckets" pass. See the algorithm
/// sketch in the accompanying explanation for how this gets populated.
model WaterfallRun {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  month            DateTime @db.Date
  /// The Ready-to-Assign pool this run distributed.
  totalAmountCents Int
  /// Leftover that couldn't be placed — every bucket was already satisfied,
  /// or the pool ran dry mid-bucket.
  remainderCents   Int

  createdAt DateTime @default(now())

  assignments BudgetAssignment[]

  @@index([workspaceId, month])
  @@map("waterfall_runs")
}

// ----------------------------------------------------------------------------
// CASHFLOW WATERFALL — one "Assign" button that splits Ready to Assign into
// Taxes / OPEX / Reservoir 1 / Reservoir 2 / Cash. See lib/budget/cashflow-waterfall.ts.
// ----------------------------------------------------------------------------

/// Per-workspace waterfall settings and the pockets that play each role.
/// The pockets themselves are ordinary Category rows (so balances, targets and
/// history all come from the normal ledger); this row only remembers which is which.
/// Personal workspace: Assign splits Ready to assign into Give / Save / Live (basis points, add to 10000).
model PersonalFlowConfig {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)
  giveBps Int     @default(2000)
  saveBps Int     @default(1000)
  liveBps Int     @default(7000)
  /// The categories (groups) each bucket pays into. A category belongs to at most one bucket.
  giveGroupIds String[] @default([])
  saveGroupIds String[] @default([])
  liveGroupIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("personal_flow_configs")
}

model WaterfallConfig {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)
  /// Share of every assigned dollar set aside for taxes (basis points, 3000 = 30%).
  taxBps  Int     @default(3000)
  /// Reservoir targets, as a number of months of OPEX (monthly cost targets). Multipliers, not money.
  reservoir1Months Decimal @default(3) @db.Decimal(5, 2)
  reservoir2Months Decimal @default(3) @db.Decimal(5, 2)
  /// Of the money that overflows Reservoir 1, the share that goes to Reservoir 2 (rest goes to Cash).
  reservoir2ShareBps Int @default(5000)

  opexGroupId          String?
  taxCategoryId        String?
  reservoir1CategoryId String?
  reservoir2CategoryId String?
  /// The category (group) whose pockets share the Cash money, by Category.cashShareBps.
  cashGroupId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waterfall_configs")
}

/// Money pulled out of a reserve to cover a shortfall. Incoming money repays
/// the oldest outstanding draws first (see planAssign).
model ReserveDraw {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bucket      ReserveBucket
  /// Total taken, and how much has been paid back so far.
  amountCents Int
  repaidCents Int           @default(0)
  /// What it covered (name kept so history survives a rename or archive).
  coveredCategoryId String?
  coveredName       String?
  month       DateTime      @db.Date
  createdAt   DateTime      @default(now())

  @@index([workspaceId, createdAt])
  @@map("reserve_draws")
}

// ----------------------------------------------------------------------------
// MONTHLY EXPENSE REVIEW
// ----------------------------------------------------------------------------

/// The three monthly questions for one expense:
///  1. Does it increase revenue or profitability?
///  2. What is its strategic value (capacity / risk / strengthens the business)?
///  3. Stewardship: is it fair, responsible and in line with the business I want to build?
model ExpenseReview {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  increasesRevenue ReviewAnswer?
  strategicValue   StrategicValue[] @default([])
  stewardship      ReviewAnswer?
  notes            String?

  reviewedById String?
  reviewedBy   User?    @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@map("expense_reviews")
}

// ----------------------------------------------------------------------------
// NET WORTH — consolidated across Personal + Business
// ----------------------------------------------------------------------------

/// Periodic cached rollup for fast charting. Source of truth is always
/// Account balances (transaction-derived or latest ManualBalanceEntry); this
/// table is a disposable performance cache, safe to fully regenerate.
model NetWorthSnapshot {
  id                    String   @id @default(cuid())
  asOfDate              DateTime @db.Date
  totalAssetsCents      Int
  totalLiabilitiesCents Int
  netWorthCents         Int
  createdAt             DateTime @default(now())

  @@unique([asOfDate])
  @@map("net_worth_snapshots")
}

/// ---------------------------------------------------------------------------
/// History layer. Past years live in their OWN tables so they can never touch
/// account balances, Ready to Assign, pockets or net worth. Only the History
/// pages and year-over-year reports read them.
/// ---------------------------------------------------------------------------

/// A past year you have gone through line by line.
model HistoryReview {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  year        Int
  reviewedAt  DateTime  @default(now())

  @@id([workspaceId, year])
  @@map("history_reviews")
}

model HistorySettings {
  workspaceId String    @id
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The day the live budget began. History must end before it.
  goLiveDate  DateTime  @db.Date
  /// Every year up to and including this one is sealed: history for it cannot be changed without unsealing. Null = none.
  sealedThrough Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("history_settings")
}

/// What the account held when its history begins, so history can be proven against the opening balance.
model HistoryAccount {
  accountId         String    @id
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startDate         DateTime? @db.Date
  startBalanceCents Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@map("history_accounts")
}

model HistoricalTransaction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  date        DateTime @db.Date
  /// Signed cents on the account: positive = money in.
  amountCents Int
  payee       String   @default("")
  memo        String   @default("")
  /// INCOME | EXPENSE | TRANSFER (transfers are kept so balances prove out, but never counted in reports).
  kind        String
  /// A WaiWai Type key (lib/budget/expense-types.ts); null = not classified yet.
  typeKey         String?
  isTaxDeductible Boolean @default(false)
  /// Hash of account + date + amount + payee + memo (+ repeat number): re-importing a file skips rows already stored.
  importHash String   @unique
  source     String?
  createdAt  DateTime @default(now())

  @@index([workspaceId, date])
  @@index([accountId, date])
  @@index([workspaceId, typeKey])
  @@map("historical_transactions")
}

/// A year's totals for one Type, for years where only a tax return exists (no transactions). Amounts are positive.
model HistoryTotal {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  year        Int
  typeKey     String
  amountCents Int
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, year, typeKey])
  @@map("history_totals")
}

/// A moment when the person compared an account to their bank. Never read by balance, Ready to Assign or net worth code.
model BalanceCheckpoint {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The day the bank balance is for.
  date          DateTime @db.Date
  /// What the bank showed, in the app's sign convention (a card you owe on is negative).
  bankCents     Int
  /// What the app said for that day.
  appCents      Int
  /// bankCents - appCents
  gapCents      Int
  /// Part of the gap parked in the Unaccounted pocket (equals gapCents once handled).
  adjustedCents Int      @default(0)
  note          String?
  createdAt     DateTime @default(now())

  @@index([accountId, date])
  @@index([workspaceId, createdAt])
  @@map("balance_checkpoints")
}

/// Credit limit of a credit card (own table so the live accounts table is untouched).
model CreditLimit {
  id         String   @id @default(cuid())
  accountId  String   @unique
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  limitCents Int
  updatedAt  DateTime @updatedAt

  @@map("credit_limits")
}

/// A charge or deposit that repeats (subscription, paycheck, loan payment). Posts when due, either on its own or after one tap.
model RecurringItem {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Pocket (no foreign key: a deleted pocket just posts uncategorized).
  categoryId  String?
  payee       String
  memo        String?
  /// Signed cents: negative = money out.
  amountCents Int
  /// WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY | YEARLY
  frequency   String
  /// Next date it is due (may be in the past when not yet posted).
  nextDate    DateTime  @db.Date
  /// Day of the month for monthly-style schedules (keeps 31st-style dates from drifting).
  anchorDay   Int
  endDate     DateTime? @db.Date
  autoPost    Boolean   @default(false)
  isDeductible Boolean  @default(false)
  isActive    Boolean   @default(true)
  lastPostedDate DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, isActive])
  @@map("recurring_items")
}


// ----------------------------------------------------------------------------
// PUSH REMINDERS — phones / computers that allowed notifications (Web Push)
// ----------------------------------------------------------------------------

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

/// Reminders already sent to a person, so each one goes out once.
model PushSent {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  sentAt DateTime @default(now())

  @@unique([userId, key])
  @@index([sentAt])
  @@map("push_sent")
}

/// Which Home sections a person shows, and in what order (JSON text: {order, hidden}).
/// A coloured label you put on pockets (Fixed, Variable, Loan, Payroll...). Yours to add to, rename and recolour.
model PocketTag {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// #RRGGBB
  color       String
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  links       PocketTagLink[]

  @@unique([workspaceId, name])
  @@map("pocket_tags")
}

model PocketTagLink {
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tagId      String
  tag        PocketTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([categoryId, tagId])
  @@index([tagId])
  @@map("pocket_tag_links")
}

model HomeLayout {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layout    String
  updatedAt DateTime @updatedAt

  @@map("home_layouts")
}

model PushPref {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pausedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("push_prefs")
}
